[submodule "src/main/java/trclib"]
	path = src/main/java/trclib
	url = https://github.com/trc492/trclib
[submodule "src/main/java/frclib"]
	path = src/main/java/frclib
	# Simulation-only frclib hooks live in the contributor fork because they
	# cannot be pushed directly to the upstream trc492/frclib repository.
	url = https://github.com/Wlute112/frclib.git
	branch = sim
